local OSTYPE="$1"
DEVICE=$2
DEVICE_IDX=$3
local GPU_OUTPUT=$4

# MAKE DEVICE LOWER
DEVICE=${DEVICE:l}

# PLATFORM
case "$OSTYPE" in
    darwin*)
        GPU=$(system_profiler SPDisplaysDataType | grep -i "chipset")
        GPUS=($P_GPU)
        AVAILABLE_A_CODECS=("${(f)$(ffmpeg -hide_banner -codecs | awk '$1 ~ /.*A.*/ && $2 ~ /\w+/ {print $2}')}")
        AVAILABLE_V_CODECS=("${(f)$(ffmpeg -hide_banner -codecs | awk '$1 ~ /.*V.*/ && $2 ~ /\w+/ {print $2}')}")
    ;;
    linux*)
        # GPUS=($(lspci | grep -i 'vga\|3d\|2d\|display'))
        GPUS=("${(f)$(lspci | grep -i 'vga\|3d\|2d\|display')}")
        GPU=$(glxinfo | grep -E "OpenGL renderer")
        AVAILABLE_A_CODECS=("${(f)$(ffmpeg -hide_banner -codecs | awk '$1 ~ /.*A.*/ && $2 ~ /\w+/ {print $2}')}")
        AVAILABLE_V_CODECS=("${(f)$(ffmpeg -hide_banner -codecs | awk '$1 ~ /.*V.*/ && $2 ~ /\w+/ {print $2}')}")
    ;;
    msys*) # WSL 2.0 only
        # GPU=$(wmic path win32_VideoController get caption)
        # GPUS=($(lspci | grep -i 'vga\|3d\|2d\|display'))
        GPUS=("${(f)$(lspci | grep -i 'vga\|3d\|2d\|display' | awk -v GPUS="${(j:|:)SUPPORTED_GPUS}" 'match($0, /.*(GPUS).*/, arr) {print arr[1]}')}")
        GPU=$(glxinfo | grep -E "OpenGL renderer")
        AVAILABLE_A_CODECS=("${(f)$(ffmpeg -hide_banner -codecs | awk '$1 ~ /.*A.*/ && $2 ~ /\w+/ {print $2}')}")
        AVAILABLE_V_CODECS=("${(f)$(ffmpeg -hide_banner -codecs | awk '$1 ~ /.*V.*/ && $2 ~ /\w+/ {print $2}')}")
    ;;
    *)
        echo "Unknown platform: $OSTYPE"
    ;;
esac

# Extract gpu name if it matches supported GPUs, return lowercase array
# Lower case
GPUS=( ${(L)GPUS} )
echo "Hardware accelerators found: ${GPUS[@]}"
# GPUS=( ${GPUS:*SUPPORTED_GPUS} )
GPUS=( ${SUPPORTED_GPUS:#GPUS} )
echo "Compatible hardware accelerators found: ${GPUS[@]}"
# Primary GPU
GPU="${GPU:l}"
# clean up string symbols
GPU="${GPU//[^[:alnum:][:space:]]/}"
# Convert to array for array intersection, I couldn't get string matching to work
GPU=(${(s: :)GPU})
GPU=${(M)GPU[(r)${(j:|:)SUPPORTED_GPUS}]}
echo "Primary gpu is: "$GPU

if [[ $DEVICE == "auto" || $DEVICE == "gpu" ]]; then
    if [[ ! -z $GPU ]]; then
        DEVICE="gpu"
    else
        DEVICE="cpu"
    fi
# Check if DEVICE is specified to an active, supported gpu
elif [[ "$DEVICE" == (${~${(j:|:)GPUS}}) ]]; then
    GPU="$DEVICE"
    DEVICE="gpu"
elif [[ $DEVICE == "cpu" ]]; then
    DEVICE="cpu"
else
    echo "ERROR: Device is specified, but none found: $DEVICE"
    exit 2
fi

typeset -g "$GPU_OUTPUT"="$GPU"
